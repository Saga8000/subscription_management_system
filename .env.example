# Copy this file to .env (same folder) and replace every CHANGE_ME value.
# Never commit .env.

APP_ENV=development

# PostgreSQL (local). The test database is wiped by the test suite - never point it at real data.
DATABASE_URL=postgresql+psycopg://brightloop_app:CHANGE_ME@localhost:5432/brightloop_sms
TEST_DATABASE_URL=postgresql+psycopg://brightloop_app:CHANGE_ME@localhost:5432/brightloop_sms_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Set to true when served over HTTPS
COOKIE_SECURE=false

CURRENCY_CODE=INR
